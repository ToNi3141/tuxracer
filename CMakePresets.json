{
    "version": 4,
    "cmakeMinimumRequired": 
    {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "include": ["RasterIX/CMakePresets.json"],
    "configurePresets": 
    [
        {
            "name": "zynq_tuxracer_if",
            "displayName": "Zynq embedded linux build",
            "description": "Build for an zynq embedded linux device",
            "binaryDir": "${sourceDir}/build/zynq",
            "generator": "Unix Makefiles",
            "inherits": [ "zynq_embedded_linux", "zynq_rixif"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "RIX_ENABLE_SPDLOG": "ON",
                "RIX_DRIVER_DMA_PROXY": "ON",
                "SDL_PATH": "../SDL",
                "CMAKE_TOOLCHAIN_FILE": "RasterIX/toolchains/toolchain_zynq.cmake"
            }
        },
        {
            "name": "zynq_tuxracer_ef",
            "displayName": "Zynq embedded linux build",
            "description": "Build for an zynq embedded linux device",
            "binaryDir": "${sourceDir}/build/zynq",
            "generator": "Unix Makefiles",
            "inherits": [ "zynq_embedded_linux", "zynq_rixef"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "RIX_ENABLE_SPDLOG": "ON",
                "RIX_DRIVER_DMA_PROXY": "ON",
                "SDL_PATH": "../SDL",
                "CMAKE_TOOLCHAIN_FILE": "RasterIX/toolchains/toolchain_zynq.cmake"
            }
        }
    ]
}